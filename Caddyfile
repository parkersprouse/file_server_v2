# Production front end for the Web File Browser (`pnpm run release`).
#
# Caddy terminates TLS for BOTH halves of the app:
#
#   browser ── https://<host>:8080 ──> Caddy ── static files ──> client/dist
#   browser ── https://<host>:8443 ──> Caddy ── plain HTTP ────> actix on 127.0.0.1:8100
#
# Both must be HTTPS together: the client builds its API base URL from
# `location.protocol` + `location.hostname` + `server_port` (client/src/lib/http.ts),
# so an HTTPS page calls an HTTPS API on the same hostname. For a release
# deployment, set `server_port = 8443` in client/src/config.toml before building
# (dev keeps pointing straight at the actix port).
#
# Ports are overridable via environment variables:
#   WEB_FILE_BROWSER_CLIENT_PORT       HTTPS+HTTP port for the SPA       (default 8080)
#   WEB_FILE_BROWSER_API_PORT          HTTPS port for the API            (default 8443)
#   WEB_FILE_BROWSER_UPSTREAM_PORT     actix's own port (`port` in server/config.toml,
#                                      default 8100)
#   WEB_FILE_BROWSER_API_HTTP_PORT     plain-HTTP port that redirects to the API's
#                                      HTTPS port                        (default 8001)
#
# ---- Client port (:8080) speaks both HTTP and HTTPS ----
#
# This requires a Caddy binary built with the `layer4` plugin
# (github.com/mholt/caddy-l4) — stock Caddy cannot do it because
# WEB_FILE_BROWSER_CLIENT_PORT is not port 443, and Caddy's automatic
# HTTP->HTTPS upgrade only ever applies to the default port. `layer4` instead
# sniffs the first bytes of each connection *before* Caddy decides what to do
# with it: a TLS ClientHello is forwarded untouched to the real HTTPS site
# block below; a plaintext HTTP request is forwarded to a tiny internal site
# block that just replies with a 301 to the HTTPS URL. Both backends listen
# on 127.0.0.1-only ports that are never exposed directly — layer4 is the
# only thing that binds the public port.
#
# Build the binaries with `bin/build-caddy.sh {macos|windows|all}` (versions
# are pinned inside the script; requires a Go toolchain, installs xcaddy on
# first run). They land at bin/caddy-l4-macos / bin/caddy-l4-windows.exe,
# gitignored build output rather than committed. `pnpm run client:release`
# picks the right one automatically via bin/run-caddy.mjs — it no longer
# calls a stock `caddy` on PATH at all.
#
# The API port (:8443) is NOT demuxed the same way: the SPA always calls it
# over the correct protocol already, so plain HTTP never reaches it in normal
# use. It keeps the simpler separate-port redirect (:8001 -> :8443) instead.
#
# Note: the actix source-IP gate sees every proxied request as coming from
# 127.0.0.1, so it no longer filters network clients. Bind actix to loopback
# (`address = "127.0.0.1"` in server/config.toml) so this proxy is the only way
# in from the network, and keep these listeners on a trusted LAN.
{
	# Every HTTPS site below already declares its own `tls` and is fronted by an
	# explicit HTTP->HTTPS redirect (either the layer4 demux or a dedicated
	# `http://` block) — without this, Caddy's auto_https also tries to open its
	# own implicit port-80 redirect listener per site, which needs a privileged
	# port and duplicates what we already do ourselves.
	auto_https disable_redirects

	servers 127.0.0.1:{$WEB_FILE_BROWSER_CLIENT_TLS_BACKEND_PORT:18080} {
		# layer4 only proxies the TCP connection, so HTTP/3 (which runs over UDP/
		# QUIC) can never reach the client TLS backend through it. Without this,
		# Caddy would still advertise `alt-svc: h3=":18080"` on responses — leaking
		# the internal loopback port for a protocol upgrade that would just fail.
		protocols h1 h2

		# Recover the client's *actual* destination address (e.g. a LAN IP) from
		# the PROXY protocol header the layer4 route below attaches, instead of
		# seeing only "127.0.0.1" (layer4's own loopback hop to this backend).
		# This matters because most TLS clients omit SNI entirely for IP-literal
		# destinations (SNI is defined for hostnames, not IPs) — when that
		# happens, Caddy's on-demand issuer falls back to the connection's local
		# address to decide what name to issue a certificate for. Without PROXY
		# protocol, that fallback always resolves to "127.0.0.1" here (issuing a
		# cert with no SAN for the real LAN IP, so no-SNI clients fail out to a
		# LAN address); with it, the fallback correctly sees the original IP the
		# browser dialed. `proxy_protocol` must come before `tls` since it reads
		# plaintext framing at the very start of the connection.
		listener_wrappers {
			proxy_protocol {
				allow 127.0.0.1/32
				timeout 2s
			}
			tls
		}
	}

	# Keep the CA and issued certs in the repo (gitignored) rather than wherever
	# $XDG_DATA_HOME happens to resolve to, so the CA — and therefore every
	# device's one-time trust of it — survives regardless of which user/environment
	# runs `pnpm run release`. Path is relative to Caddy's working directory, which
	# is the repo root (see the `client:release` script in package.json).
	storage file_system {
		root ./.caddy
	}

	# Issue certificates from Caddy's built-in local CA instead of a public ACME
	# CA — this is a LAN deployment with no public domain. Each device that
	# browses the app must trust that CA's root once:
	#   - on this machine: `caddy trust` (or it is installed automatically when
	#     Caddy has permission to do so)
	#   - on other devices: import the root certificate from
	#     ./.caddy/pki/authorities/local/root.crt
	local_certs

	# Demux the client port: TLS ClientHellos go to the real HTTPS site block,
	# plain HTTP requests go to the redirect-only site block. Both destinations
	# are loopback-only backends, never bound on the public interface directly.
	layer4 {
		:{$WEB_FILE_BROWSER_CLIENT_PORT:8080} {
			@tls tls
			route @tls {
				proxy {
					proxy_protocol v2
					upstream 127.0.0.1:{$WEB_FILE_BROWSER_CLIENT_TLS_BACKEND_PORT:18080}
				}
			}
			@http http
			route @http {
				proxy 127.0.0.1:{$WEB_FILE_BROWSER_CLIENT_REDIRECT_BACKEND_PORT:18081}
			}
		}
	}
}

# ---- Redirect: plain HTTP -> HTTPS for the API half ----
http://:{$WEB_FILE_BROWSER_API_HTTP_PORT:8001} {
	redir https://{host}:{$WEB_FILE_BROWSER_API_PORT:8443}{uri} permanent
}

# ---- Client: the built SPA, replacing `serve` ----
# Loopback-only: reached exclusively through the layer4 proxy above, never
# bound on the public interface. `bind` restricts the interface without
# setting a Host matcher, so LAN clients whose Host is an IP/mDNS name (not
# literally "127.0.0.1") still match — the layer4 proxy forwards the raw TLS
# bytes untouched, so SNI/Host reach this block exactly as the browser sent them.
https://:{$WEB_FILE_BROWSER_CLIENT_TLS_BACKEND_PORT:18080} {
	bind 127.0.0.1

	# Mint a certificate for whatever name the browser used (LAN IP, mDNS name,
	# localhost, ...) at handshake time, so no hostnames are hardcoded here.
	tls internal {
		on_demand
	}

	root * ./client/dist
	encode zstd gzip

	# SPA fallback: vue-router owns the path space (equivalent of `serve --single`).
	try_files {path} /index.html
	file_server
}

# ---- Client redirect backend: plain HTTP -> HTTPS, same public port ----
# Loopback-only, fed exclusively by the layer4 @http route above.
http://:{$WEB_FILE_BROWSER_CLIENT_REDIRECT_BACKEND_PORT:18081} {
	bind 127.0.0.1
	redir https://{host}:{$WEB_FILE_BROWSER_CLIENT_PORT:8080}{uri} permanent
}

# ---- API: TLS in front of the Rust server ----
https://:{$WEB_FILE_BROWSER_API_PORT:8443} {
	tls internal {
		on_demand
	}

	# The original Host header is passed through (Caddy's default), which the
	# server's Host allowlist / DNS-rebinding guard relies on.
	reverse_proxy 127.0.0.1:{$WEB_FILE_BROWSER_UPSTREAM_PORT:8100}
}
