{
  "name": "web_file_browser_client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "browserslist": "since 2018, > 0.3%, not dead",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "^24",
    "pnpm": "^12"
  },
  "scripts": {
    "start": "pnpm run dev",
    "dev": "vite",
    "prebuild": "pnpm run clean:dist",
    "build": "run-p check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "check": "vue-tsc -b",
    "lint": "run-s --continue-on-error lint:css lint:js",
    "lint:fix": "run-s --continue-on-error lint:css:fix lint:js:fix",
    "lint:css": "stylelint \"**/*.{css,vue}\"",
    "lint:css:fix": "stylelint --fix \"**/*.{css,vue}\"",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "clean:dist": "rimraf -I dist",
    "preclean": "pnpm run clean:dist",
    "clean": "rimraf -I -g \"**/node_modules\"",
    "clean:lockfile": "rimraf -I -g \"**/pnpm-lock.yaml\"",
    "clean:deep": "run-s clean:lockfile clean",
    "refresh": "pnpm run clean && pnpm install",
    "refresh:deep": "pnpm run clean:deep && pnpm install",
    "component:add": "pnpm exec shadcn-vue add"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-virtual": "^3.13.41",
    "@videojs/html": "10.1.0",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.20.0",
    "caniuse-lite": "^1.0.30001815",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.16",
    "emittery": "^2.1.0",
    "marked": "^18.1.0",
    "pinia": "^4.0.3",
    "reka-ui": "^2.11.0",
    "remeda": "^2.51.0",
    "sanitize.css": "^13.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "ua-parser-js": "^2.0.10",
    "vaul-vue": "^0.4.1",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/ri": "^1.2.10",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@stylistic/stylelint-plugin": "^5.3.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/caniuse-lite": "^1.0.5",
    "@types/node": "^24.13.2",
    "@types/prismjs": "^1.26.6",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-import-resolver-custom-alias": "^1.3.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^18.4.1",
    "eslint-plugin-unicorn": "^77.0.0",
    "eslint-plugin-vue": "~10.11.1",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "lightningcss": "^1.33.0",
    "npm-run-all2": "^9.0.3",
    "rimraf": "^6.1.3",
    "shadcn-vue": "^2.8.2",
    "stylelint": "^17.16.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-plugin-defensive-css": "^2.9.7",
    "stylelint-use-nesting": "^6.0.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "unplugin-icons": "^24.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.4",
    "vite-plugin-toml": "^0.9.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.13"
  }
}
